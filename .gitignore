# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]

# Node / Vite (arriving with the web/ app in P1+)
node_modules/
web/dist/
.vite/

# Runtime log — written by POST /__notlinear_runtime_logs on every session,
# so tracking it means a diff after merely opening the app.
logs.md

# User content, not source. These stay on disk; they are simply not the
# repo's business, and they are the main thing that must never reach a
# public mirror.
uploads/
feedback/media/

# Local agent settings (already ignored globally; made explicit so a fresh
# clone inherits it rather than relying on ~/.config/git/ignore)
.claude/settings.local.json

# Design handoffs and their zips — large binary drops, not source
*.zip
design-system-improvements*/
design_handoff_notlinear_redesign*/
Design Docs/
Claude outputs/

# Compiled macOS launcher binary — a build artifact of
# launchers/build-macos-app.command, not source. Rebuild it with that script.
launchers/Notlinear.app/Contents/MacOS/

# Test and build output
.venv/
web/node_modules/
web/test-results/
web/playwright-report/
web/.playwright/

# Real-data fixtures are generated locally from a backup and are redacted
# before committing — see web/scripts/backup-to-fixture.mjs. They are NOT
# ignored (committing them is what makes the round-trip test run in CI);
# the raw backups they come from must never be in the repo.
notlinear-backup-*.json

# Parked, not needed to run the app or its tests. Moved here instead of deleted; restore by moving back.
_archive/
.claude/.deploy-marker

# Personal agent config and hooks (deploy hook is machine-specific)
.claude/

# Personal planning docs (open-source prep)
plan_final.md
licenses_plan.md

# ---- Personal / private (open-source prep): stays on disk, never published ----
# Legacy vanilla-JS app and its launchers: superseded by web/
frontend/
notlinear.html
notlinear_server.py
launchers/
# Agent and project working memory, plans, notes
docs/
AGENTS.md
CLAUDE.md
BUGS.md
FEATURES.md
MIGRATION.md
plan.md
redesign_product.md
notes_new_feature.md
feedback/
# Local-only legacy parity tests (need frontend/)
web/tests/legacy-oracle/
web/vitest.oracle.config.ts
